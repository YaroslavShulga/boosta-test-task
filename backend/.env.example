PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app
# Apply pending migrations on application start.
DB_MIGRATIONS_RUN=true

# At least 16 characters.
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime, seconds.
JWT_TTL=604800

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3001
# Express `trust proxy`: hops allowed to set X-Forwarded-For (the Next.js /api proxy).
TRUST_PROXY=loopback, linklocal, uniquelocal

# For a cross-site deploy (frontend and API on different domains) use
# COOKIE_SECURE=true and COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
