# Variables for the production compose stack (docker-compose.yml).
# Copy to .env next to docker-compose.yml: compose reads it automatically.

# Required.
DB_PASSWORD=postgres
# At least 16 characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-secret

# Optional (defaults shown).
DB_USERNAME=postgres
DB_NAME=app
# Access token lifetime, seconds.
JWT_TTL=604800
# Host port of Postgres (published for local inspection, e.g. with a DB client).
DB_PORT=5432
# Host port of the frontend .
FRONTEND_PORT=3001
# Public URL of the frontend.
APP_URL=http://localhost:3001
# true when served over HTTPS (Secure cookies are dropped on plain http outside localhost).
COOKIE_SECURE=false
